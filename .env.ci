# CI environment — safe to commit, contains NO secrets.
# All secrets (real DB passwords, SMTP creds, etc.) live in GitHub Actions secrets.
DJANGO_SECRET_KEY=ci-only-not-a-real-secret-do-not-use-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=django.db.backends.postgresql
DB_NAME=manageopd_ci
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=0
DB_SSLMODE=disable

FRONTEND_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

AUTH_COOKIE_SECURE=0

# Use in-memory email backend — no real emails sent in CI
EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
DEFAULT_FROM_EMAIL=noreply@manageopd.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Run Celery tasks synchronously in CI (no broker needed)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=1

LOG_LEVEL=WARNING

ENABLE_SRS_V03_AI_FIRST=0
VOICE_AGENT_ESCALATION_POLICY=conservative
