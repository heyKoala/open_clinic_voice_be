DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=django.db.backends.postgresql
DB_NAME=manageopd
DB_USER=postgres
DB_PASSWORD=123
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer

FRONTEND_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

AUTH_COOKIE_SECURE=0

# Email — use console backend for local dev, configure SMTP for staging/prod
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@manageopd.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Celery — set CELERY_TASK_ALWAYS_EAGER=1 to run tasks synchronously in dev
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=1

# Logging
LOG_LEVEL=INFO

# Feature flags
# NOTE: ENABLE_SRS_V03_AI_FIRST is reserved for a future AI-first intake flow.
# Setting it to 1 has no effect yet — the flag is read in settings.py but no
# code path branches on it. Do not set this to 1 expecting behaviour to change.
ENABLE_SRS_V03_AI_FIRST=0
VOICE_AGENT_ESCALATION_POLICY=conservative

# Rock8 Voice API Configuration
ROCK8_API_KEY=
ROCK8_WEBHOOK_SECRET=

# WhatsApp Cloud API (leave token/phone id blank to mock sends in development)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Real-time events: "redis" lets Celery workers push live updates (uses REDIS_URL); default "memory" in DEBUG
CHANNEL_LAYER=redis
REDIS_URL=redis://127.0.0.1:6379/2

# Plivo telephony (clinic phone numbers). PLIVO_APP_ID is the Plivo application / SIP trunk
# that forwards calls to the voice agent.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_APP_ID=
